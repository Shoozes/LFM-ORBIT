{
  "name": "lfm-orbit-frontend",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:hosted": "tsc && vite build --mode hosted",
    "build:pages": "tsc && vite build --mode pages",
    "preview": "vite preview",
    "preview:hosted": "vite preview --mode hosted",
    "preview:pages": "vite preview --mode pages",
    "lint": "tsc --noEmit",
    "test:unit": "node --test tests/*.test.mjs",
    "test:e2e": "npx playwright test",
    "test:hosted": "npx playwright test -c playwright.hosted.config.ts",
    "test:hosted:build": "npx playwright test -c playwright.hosted.build.config.ts",
    "test:hosted:pages": "npx playwright test -c playwright.hosted.pages.config.ts",
    "test:hosted:pages:live": "npx playwright test -c playwright.hosted.pages.live.config.ts",
    "test:hosted:model": "npx playwright test -c playwright.hosted.model.config.ts",
    "test:hosted:model:build": "npm run build:hosted && npx playwright test -c playwright.hosted.model.build.config.ts",
    "verify:hosted": "npm run test:unit && npm run build:hosted && npm run test:hosted:build",
    "demo:hosted": "npx playwright test -c playwright.hosted.capture.config.ts",
    "demo:record": "npx playwright test -c playwright.demo.config.ts e2e/demos",
    "demo:showcase": "npx playwright test -c playwright.demo.config.ts e2e/demos/showcase.demo.spec.ts",
    "demo:payload": "npx playwright test -c playwright.demo.config.ts e2e/demos/payload-reduction.demo.spec.ts",
    "demo:tutorial": "npx playwright test e2e/tutorial_video.spec.ts",
    "demo:report": "npx playwright show-report"
  },
  "dependencies": {
    "@wllama/wllama": "^3.5.1",
    "maplibre-gl": "^5.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/geojson": "^7946.0.14",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.2",
    "vite": "^8.2.0"
  }
}
