# Copy to .env for local runs. The launchers load this file automatically.

# Default cold-start mode. SimSat/Mapbox is the hackathon satellite-data API
# family. The default realtime lane is SimSat Sentinel; SimSat Mapbox is the
# optional imagery/context lane when a Mapbox token is configured. The app falls
# back locally if SimSat is absent and avoids direct external API calls unless
# explicitly enabled below.
OBSERVATION_PROVIDER=simsat_sentinel
SIMSAT_ENABLED=true
SIMSAT_DATA_SOURCE=sentinel
SIMSAT_BASE_URL=http://localhost:8080
SIMSAT_TIMEOUT=30

# Optional: use SimSat's Mapbox endpoint.
# OBSERVATION_PROVIDER=simsat_mapbox
# SIMSAT_DATA_SOURCE=mapbox
# The hackathon SimSat wrapper only needs this to be non-empty for Orbit to
# route Mapbox requests, but real upstream Mapbox imagery still requires a
# valid token. Empty SimSat image payloads are rejected as unavailable.
MAPBOX_ACCESS_TOKEN=

# Optional direct providers. These are manual development choices only; having
# local secrets present does not move the default runtime away from SimSat.
# To use one, set OBSERVATION_PROVIDER to sentinelhub_direct, nasa_api_direct,
# or gee.
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=
NASA_API_KEY=
GEE_API_KEY=
GEE_CLIENT_ID=

# Trained Orbit GGUF pull for production/hackathon runs. The launchers and
# fetch script default to the published Orbit bundle below when
# -FetchModel/--fetch-model is used.
LFM_MODEL_REPO_ID=Shoozes/lfm2.5-450m-vl-orbit-satellite
LFM_MODEL_REVISION=main

# Legacy direct GGUF URL override. Leave empty to use the manifest-aware repo pull.
LFM_MODEL_URL=

# Optional runtime manifest overrides for local experiments.
CANOPY_SENTINEL_MODEL_REPO_ID=
CANOPY_SENTINEL_MODEL_REVISION=
CANOPY_SENTINEL_MODEL_MANIFEST=
CANOPY_SENTINEL_MODEL_SUBDIR=
CANOPY_SENTINEL_MODEL_FILENAME=
CANOPY_SENTINEL_MODEL_MMPROJ_FILENAME=
CANOPY_SENTINEL_LLAMACPP_CHAT_FORMAT=chatml
CANOPY_SENTINEL_LLAMACPP_PATCH_CHAT_TEMPLATE=true
ORBIT_IMAGE_CONDITIONED_INFERENCE=false
ORBIT_IMAGE_INFERENCE_BACKEND=none
ORBIT_REQUIRE_MMPROJ_FOR_IMAGE_INFERENCE=true

# Optional Depth Anything V3 geometry lane. Disabled by default so local/CI
# runs can still skip heavyweight local inference packages during development.
DEPTH_ANYTHING_V3_ENABLED=false
DEPTH_ANYTHING_V3_MODEL=depth-anything/da3-large
DEPTH_ANYTHING_V3_DEVICE=auto
DEPTH_ANYTHING_V3_MAX_PIXELS=1048576

# Development/test controls.
DISABLE_EXTERNAL_APIS=true
RESET_RUNTIME_STATE_ON_BOOT=false
RESUME_ACTIVE_MISSION_ON_BOOT=false
VITE_API_BASE_URL=http://127.0.0.1:8000
